# =============================================================================
# DMARS -- Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# =============================================================================

# -- LLM API Keys (Switched to SiliconFlow for Chinese Models) -----------------
SILICONFLOW_API_KEY=sk-your-key-here
# Optional: keep these if you still want to use fallback or non-Chinese models
OPENAI_API_KEY=sk-proj-xxx
GROQ_API_KEY=gsk_xxx
ANTHROPIC_API_KEY=sk-ant-xxx
GOOGLE_API_KEY=AIzaSyxxx

# -- Research (Checkpoint 15a) --------------------------------------------------
FIRECRAWL_API_KEY=fc-your-key-here
FIRECRAWL_RATE_LIMIT_PER_MIN=10    # Max Firecrawl scrape/search calls per minute

# !! CHINESE MODELS ENABLED !! Using DeepSeek, Qwen, and GLM via SiliconFlow.

# -- Database ------------------------------------------------------------------
# Phase 1: SQLite (no setup needed)
# DATABASE_URL=sqlite+aiosqlite:///./dmars.db

# Phase 2+ (Checkpoint 15): PostgreSQL, via the async psycopg3 driver
# (asyncpg needs a C++ compiler to build on Windows; psycopg[binary] doesn't).
DATABASE_URL=postgresql+psycopg://dmars_user:password@localhost:5432/dmars_db

# -- Application ---------------------------------------------------------------
ENV=development                    # development | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
ACTIVE_PROMPT_VERSION=v1           # v1 | v2 | ...

# -- Scoring & Cache -----------------------------------------------------------
CACHE_SIMILARITY_THRESHOLD=0.92    # GPTCache cosine similarity threshold (Phase 2)

# -- Budget Alerts -------------------------------------------------------------
DAILY_COST_ALERT_USD=5.00          # Alert when daily API spend exceeds this
PER_QUERY_COST_ALERT_USD=0.10      # Alert when single query exceeds this

# -- Redis (Phase 2+) ----------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0

# -- LangFuse Observability (Phase 2+) -----------------------------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com   # or self-hosted URL
